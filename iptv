<!DOCTYPE html>
<html lang="pt-PT">

<head>

<meta charset="utf-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1">

<title>Hugo Drive IPTV</title>

<style>

body{
    margin:0;
    background:#090b11;
    color:white;
    font-family:Segoe UI,Arial,sans-serif;
}

.container{
    max-width:700px;
    margin:auto;
    padding:30px;
}

.card{
    background:#161b22;
    padding:25px;
    border-radius:20px;
}

h1{
    text-align:center;
}

input{
    width:100%;
    padding:14px;
    margin-top:10px;
    margin-bottom:20px;
    border:none;
    border-radius:10px;
    font-size:16px;
}

button{
    width:100%;
    padding:15px;
    background:#6a5cff;
    color:white;
    border:none;
    border-radius:10px;
    cursor:pointer;
    font-size:18px;
}

button:hover{
    background:#5443ff;
}

.info{
    margin-top:20px;
    font-size:14px;
    color:#bbb;
}

</style>

</head>

<body>

<div class="container">

<div class="card">

<h1>📺 Hugo Drive IPTV</h1>

<label>URL</label>

<input id="server"
       placeholder="http://tron.robotman.top">

<label>Utilizador</label>

<input id="username"
       placeholder="Username">

<label>Password</label>

<input id="password"
       type="password"
       placeholder="Password">

<button onclick="saveConfig()">
Guardar Configuração
</button>

<button onclick="openPortal()"
        style="margin-top:10px">
Abrir Portal IPTV
</button>

<div class="info">

A configuração fica guardada no browser.

</div>

</div>

</div>

<script>

document.getElementById("server").value =
 localStorage.getItem("iptv_server") || "";

document.getElementById("username").value =
 localStorage.getItem("iptv_user") || "";

document.getElementById("password").value =
 localStorage.getItem("iptv_pass") || "";

function saveConfig(){

 localStorage.setItem(
   "iptv_server",
   document.getElementById("server").value
 );

 localStorage.setItem(
   "iptv_user",
   document.getElementById("username").value
 );

 localStorage.setItem(
   "iptv_pass",
   document.getElementById("password").value
 );

 alert("Configuração guardada");
}

function openPortal(){

 const server =
   document.getElementById("server").value;

 window.open(
   server,
   "_blank"
 );

}

</script>

</body>

</html>
